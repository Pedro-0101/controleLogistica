DATABASE_URL=postgresql+psycopg2://logistica:logistica@localhost:5432/controle_logistica
ANPR_LANG=en

# Autenticação (JWT)
SECRET_KEY=troque-esta-chave-secreta-com-32-caracteres-minimo
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Usuário admin inicial (seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=troque-esta-senha
ADMIN_NOME=Administrador

# DVR Intelbras (snapshot das câmeras). Credenciais do DVR (Digest).
# A URL de cada câmera (host, porta e canal) fica em Ponto.camera_url.
DVR_USER=admin
DVR_PASSWORD=troque-esta-senha
DVR_AUTH=digest
DVR_TIMEOUT=5.0
